/**
 * @file main.cpp
 * @brief Enterprise Главная точка входа V8Unpack
 *
 * ПОЛНОСТЬЮ РЕФАКТОРИРОВАННАЯ АРХИТЕКТУРА на основе SOLID принципов.
 * Миграция с монолитного подхода на enterprise уровень с применением
 * всех современных паттернов проектирования.
 *
 * ## 🎯 SOLID Design Principles:
 * - **SRP** (Single Responsibility): Каждый класс отвечает за одну функцию
 * - **OCP** (Open-Closed): Расширение через наследование, не модификацию
 * - **LSP** (Liskov Substitution): Наследники полностью заменяют базовые классы
 * - **ISP** (Interface Segregation): Минимальные интерфейсы
 * - **DIP** (Dependency Inversion): Зависимости от абстракций
 *
 * ## 🏗️ Enterprise Design Patterns:
 * - **Facade**: Application координирует всю систему
 * - **Factory**: CommandFactory создает команды динамически
 * - **Strategy**: Команды как стратегии выполнения
 * - **Command**: Каждая операция инкапсулирована в объект
 * - **Observer**: Логирование через MessageRegistrator
 * - **Bridge**: CommandBridge интегрирует legacy код
 * - **Adapter**: Для совместимости с существующими функциями
 *
 * ## 🚀 Enterprise Benefits:
 * - **Production Quality**: Enterprise-class architecture
 * - **Full Testability**: DI для complete unit/integration testing
 * - **Professional Maintenance**: Clear separation of concerns
 * - **Unlimited Extensibility**: Easy new commands/features adding
 * - **Enterprise Reliability**: Centralized error handling
 * - **Performance**: Optimized strategies for different scenarios
 *
 * ## 🔧 Architecture Layers:
 * 1. **Application Layer** (Facade): Application orchestrates everything
 * 2. **Business Logic Layer**: CommandSystem, MetadataAnalysis, BatchProcessor
 * 3. **Infrastructure Layer**: ErrorCodes, StringConverters, Logging
 * 4. **Presentation Layer**: ArgParser, CommandLine interface
 */

#include "app/Application.h"
#include <iostream>
#include <exception>
#include <memory>
#include <csignal>

using namespace v8unpack;

/**
 * @brief Enterprise main() function
 *
 * Complete migration from monolithic main.cpp to SOLID enterprise architecture.
 * This main() uses the new Application facade pattern to orchestrate all functionality.
 *
 * @param argc Number of command line arguments
 * @param argv Array of command line arguments
 * @return Exit code (0 for success, non-zero for errors)
 */
int main(int argc, char* argv[])
{
    try {
        // Signal handling for graceful shutdown
        signal(SIGINT, [](int sig) {
            std::cout << "\nReceived interrupt signal. Exiting gracefully..." << std::endl;
            std::exit(sig);
        });

        // Create Application using Factory pattern
        // Dependency Injection: Application depends on abstractions (shared_ptr interfaces)
        auto application = ApplicationFactory::createDefault();

        if (!application) {
            std::cerr << "CRITICAL ERROR: Failed to create Application!" << std::endl;
            std::cerr << "This indicates severe architectural issues." << std::endl;
            return EXIT_FAILURE;
        }

        // Validate Application initialization
        if (!application->isInitialized()) {
            std::cerr << "CRITICAL ERROR: Application failed initialization!" << std::endl;
            std::cerr << "Check component dependencies and configuration." << std::endl;
            return EXIT_FAILURE;
        }

        std::cout << "V8Unpack Enterprise Architecture v" << application->getVersion() << std::endl;
        std::cout << "SOLID Design Principles | Professional Command System | Full DI Testing" << std::endl;
        std::cout << "=================================================================" << std::endl;
        std::cout << std::endl;

        // Execute application through Facade pattern
        // All complexity hidden behind clean Application::run() interface
        int exitCode = application->run(argc, argv);

        std::cout << "\n=================================================================" << std::endl;
        std::cout << "Enterprise Application Framework exited with code: " << exitCode << std::endl;
        std::cout << "SOLID Architectures | Professional Design Patterns | Enterprise Quality" << std::endl;

        return exitCode;

    } catch (const std::exception& ex) {
        std::cerr << "\nFATAL ERROR: Unhandled exception in enterprise application framework!" << std::endl;
        std::cerr << "Exception: " << ex.what() << std::endl;
        std::cerr << "Please report this to the development team." << std::endl;

        // Enterprise error logging would go here
        // ErrorReportingService::reportFatal(ex);

        return EXIT_FAILURE;

    } catch (...) {
        std::cerr << "\nFATAL ERROR: Unknown exception in enterprise application framework!" << std::endl;
        std::cerr << "This is a critical system error requiring immediate attention." << std::endl;

        // Enterprise error logging would go here
        // ErrorReportingService::reportUnknownFatal();

        return EXIT_FAILURE;
    }
}
