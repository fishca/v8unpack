#### 3.2 Заменить старую логику обработки команд
```cpp
// Заменить весь блок с get_run_mode на:
std::vector<std::string> args;
for (int i = 1; i < argc; i++) {
    args.emplace_back(argv[i]);
}

if (args.empty()) {
    registry->showHelp();
    return 1;
}

auto command = registry->getCommand(args[0]);
if (!command) {
    std::cerr << "Неизвестная команда: " << args[0] << std::endl;
    registry->showHelp();
    return 1;
}

args.erase(args.begin()); // Удалить имя команды из аргументов
return command->execute(args);
```

### 4. Обработка специальных случаев

#### 4.1 Команды с флагами (-list, -version и т.д.)
Некоторые команды имеют префиксы. Обработать в CommandRegistry:
```cpp
Command* getCommand(std::string name) const {
    // Удалить префиксы
    if (name[0] == '-') {
        name = name.substr(1);
    }

    // Обработать короткие имена
    static const std::map<std::string, std::string> aliases = {
        {"u", "unpack"},
        {"unp", "unpack"},
        {"pa", "pack"},
        {"p", "parse"},
        {"b", "build"},
        {"l", "list"},
        {"lf", "listfiles"},
        {"v", "version"},
        {"e", "example"},
        {"bat", "bat"}
    };

    auto it = aliases.find(name);
    if (it != aliases.end()) {
        name = it->second;
    }

    return getCommandInternal(name);
}
```

